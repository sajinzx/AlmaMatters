# Server Configuration
PORT=3000
NODE_ENV=production

# Supabase / PostgreSQL Direct Connection String (Recommended)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Or Transaction Pooler (port 6543):
# Format: postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:your-supabase-password@db.your-project-ref.supabase.co:5432/postgres

# Alternatively, discrete parameters:
# DB_HOST=db.your-project-ref.supabase.co
# DB_USER=postgres
# DB_PASSWORD=your-password
# DB_NAME=postgres
# DB_PORT=5432
# DB_SSL=true

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_here
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Email OTP Notifications (Optional - uses Gmail SMTP or console output in dev)
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_password
